{
  "version": 1,
  "name": "Integral windup demonstration",
  "description": "Large integral gain with a weak motor and anti-windup OFF: the integrator winds up while the output is saturated and causes a large overshoot. Run an experiment, switch anti-windup to 'clamp' or 'back_calculation', run again and compare.",
  "plant": {
    "base_type": "fixed",
    "gravity": 9.81,
    "cart_mass": 1.0,
    "cart_viscous_friction": 0.1,
    "track_length": 4.0,
    "actuator": {
      "max_output": 0.8,
      "rate_limit": 0.0,
      "time_constant": 0.002,
      "deadband": 0.0
    },
    "segments": [
      {
        "length": 0.5,
        "mass": 0.2,
        "com_ratio": 0.5,
        "inertia": 0.004166666666666667,
        "joint_viscous_friction": 0.0005,
        "joint_coulomb_friction": 0.0,
        "initial_angle_deg": 25.0,
        "initial_velocity_dps": 0.0
      }
    ]
  },
  "controller": {
    "enabled": true,
    "frequency_hz": 500.0,
    "output_min": -0.8,
    "output_max": 0.8,
    "action": "reverse",
    "loops": [
      {
        "name": "Segment 1 angle",
        "signal": "theta1",
        "enabled": true,
        "setpoint": 0.0,
        "kp": 6.0,
        "ki": 20.0,
        "kd": 0.35,
        "p_enabled": true,
        "i_enabled": true,
        "d_enabled": true,
        "integral_limit": 0.0,
        "anti_windup": "none",
        "back_calculation_gain": 10.0,
        "derivative_mode": "measured_rate",
        "derivative_filter_hz": 50.0
      }
    ]
  },
  "simulation": {
    "dt": 0.001,
    "sensor_noise_angle_deg": 0.0,
    "sensor_noise_rate_dps": 0.0,
    "sensor_noise_position": 0.0,
    "noise_seed": 1,
    "telemetry_rate_hz": 200.0
  },
  "experiment": {
    "duration": 6.0,
    "settle_tolerance_deg": 1.0,
    "disturbance": {
      "enabled": false,
      "time": 2.0,
      "force": 2.0,
      "duration": 0.1
    }
  }
}
